{
  "name": "trust-core-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "trust:test": "vitest run tests/trust-test.test.ts",
    "infra:start": "docker compose up -d postgres minio && docker compose run --rm minio-init",
    "infra:wait": "docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "infra:stop": "docker compose stop postgres minio",
    "infra:reset": "docker compose down --volumes --remove-orphans",
    "docker:up": "pnpm infra:wait",
    "docker:check": "docker compose ps postgres minio",
    "docker:down": "docker compose down",
    "docker:reset": "pnpm infra:reset",
    "db:migrate": "pnpm --filter @trust-core/api db:migrate",
    "db:provision": "pnpm --filter @trust-core/api db:provision",
    "db:test:postgres": "node scripts/postgres-integration.mjs",
    "trust:test:docker": "node scripts/trust-test-docker.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm trust:test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
