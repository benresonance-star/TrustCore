{
  "name": "trust-core-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "prettier --write \"apps/trust-control-centre/**/*.{ts,tsx,css,json}\" \"packages/sdk-typescript/**/*.{ts,json}\" \"package.json\" \"pnpm-{lock,workspace}.yaml\" \"tsconfig.base.json\" \".github/workflows/*.yml\"",
    "lint": "prettier --check \"apps/trust-control-centre/**/*.{ts,tsx,css,json}\" \"packages/sdk-typescript/**/*.{ts,json}\" \"package.json\" \"pnpm-{lock,workspace}.yaml\" \"tsconfig.base.json\" \".github/workflows/*.yml\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "generate:openapi": "pnpm --filter @trust-core/protocol generate:openapi",
    "check:openapi": "pnpm generate:openapi && git diff --exit-code -- contracts/openapi.json",
    "trust:test": "vitest run tests/trust-test.test.ts",
    "infra:start": "docker compose up -d postgres minio && docker compose run --rm minio-init",
    "infra:wait": "docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "infra:stop": "docker compose stop postgres minio",
    "infra:reset": "docker compose down --volumes --remove-orphans",
    "docker:up": "pnpm infra:wait",
    "docker:check": "docker compose ps postgres minio",
    "docker:down": "docker compose down",
    "docker:reset": "pnpm infra:reset",
    "db:migrate": "pnpm --filter @trust-core/api db:migrate",
    "db:provision": "pnpm --filter @trust-core/api db:provision",
    "db:test:postgres": "node scripts/postgres-integration.mjs",
    "trust:test:docker": "node scripts/trust-test-docker.mjs",
    "check": "pnpm audit:prod && pnpm typecheck && pnpm test && pnpm trust:test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
