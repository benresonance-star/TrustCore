{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-core.local/contracts/docker-gate-report.schema.json",
  "title": "Trust Core Release 0.1 Docker gate report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "status",
    "startedAt",
    "finishedAt",
    "durationMs",
    "environment",
    "stages"
  ],
  "properties": {
    "release": {
      "const": "0.1"
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "node", "docker"],
      "properties": {
        "platform": { "type": "string" },
        "node": { "type": "string" },
        "docker": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "durationMs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "skipped"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
