{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-core.example/contracts/application-manifest.schema.json",
  "title": "Trust Core Application Protocol Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "namespace",
    "name",
    "applicationVersion",
    "schemaPackage",
    "capabilities",
    "lifecycle"
  ],
  "properties": {
    "protocolVersion": { "const": "TCAP/1.0" },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[/-][a-z0-9][a-z0-9-]*)+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "applicationVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "schemaPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "resourceTypes",
        "relationTypes",
        "blobRoles",
        "additionalFields"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "resourceTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "relationTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "blobRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "additionalFields": { "enum": ["preserve", "reject"] }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "dataset:read",
          "resource:read",
          "revision:create",
          "object:ingest",
          "blob:read",
          "relation:read",
          "history:read",
          "portability:read"
        ]
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deletion", "revisionHistory", "portability"],
      "properties": {
        "deletion": { "const": "logical-first" },
        "revisionHistory": { "const": "append-only" },
        "portability": { "const": "required" }
      }
    }
  }
}
