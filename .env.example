NODE_ENV=development
TRUST_API_PORT=4310
POSTGRES_DB=trust_core
POSTGRES_USER=trust_admin
POSTGRES_PASSWORD=trust_admin_local_only
POSTGRES_PORT=54329
MINIO_ROOT_USER=trustcore
MINIO_ROOT_PASSWORD=trustcore-local-secret
MINIO_API_PORT=5900
MINIO_CONSOLE_PORT=5901
# Required before live mutation routes are enabled. Use a secret manager in production.
TRUST_ADMIN_TOKEN=replace-with-a-long-random-local-token
TRUST_ADMIN_ACTOR_ID=local-admin
# Control Centre build-time values when enabling its authenticated HTTP gateway.
VITE_TRUST_API_BASE=/api
# Set this to the live workspace UUID returned by provisioning.
VITE_TRUST_WORKSPACE_ID=workspace-demo
# Optional production identity provider. Passkeys/MFA are configured at this provider.
TRUST_OIDC_ISSUER=https://identity.example.com
TRUST_OIDC_CLIENT_ID=trust-core-control-centre
TRUST_OIDC_CLIENT_SECRET=replace-from-secret-manager
TRUST_OIDC_REDIRECT_URI=https://trust.example.com/v1/auth/oidc/callback
TRUST_OIDC_ROLE_CLAIM=roles
TRUST_OIDC_WORKSPACE_CLAIM=trust_workspaces
# Runtime roles are created by `pnpm db:provision`.
TRUST_APP_DB_PASSWORD=trust_app_local_only
TRUST_WORKER_DB_PASSWORD=trust_worker_local_only
TRUST_VERIFIER_DB_PASSWORD=trust_verifier_local_only
TRUST_AUDIT_READER_DB_PASSWORD=trust_audit_reader_local_only
TRUST_AUDIT_WRITER_DB_PASSWORD=trust_audit_writer_local_only
TRUST_BACKUP_DB_PASSWORD=trust_backup_local_only
DATABASE_URL=postgresql://trust_app_local:trust_app_local_only@localhost:54329/trust_core
# Owner URL: migration and provisioning commands only.
TRUST_MIGRATION_DATABASE_URL=postgresql://trust_admin:trust_admin_local_only@localhost:54329/trust_core
# Set DATABASE_URL to this value when starting the worker.
TRUST_WORKER_DATABASE_URL=postgresql://trust_worker_local:trust_worker_local_only@localhost:54329/trust_core
TRUST_VERIFIER_DATABASE_URL=postgresql://trust_verifier_local:trust_verifier_local_only@localhost:54329/trust_core
TRUST_AUDIT_READER_DATABASE_URL=postgresql://trust_audit_reader_local:trust_audit_reader_local_only@localhost:54329/trust_core
TRUST_AUDIT_WRITER_DATABASE_URL=postgresql://trust_audit_writer_local:trust_audit_writer_local_only@localhost:54329/trust_core
TRUST_BACKUP_DATABASE_URL=postgresql://trust_backup_local:trust_backup_local_only@localhost:54329/trust_core
TRUST_STORAGE_ENDPOINT=http://localhost:5900
TRUST_STORAGE_REGION=us-east-1
TRUST_STORAGE_BUCKET=trust-core-local
TRUST_STORAGE_ACCESS_KEY=trustcore
TRUST_STORAGE_SECRET_KEY=trustcore-local-secret
TRUST_STORAGE_FORCE_PATH_STYLE=true
TRUST_WORKER_INTERVAL_MS=5000
TRUST_WORKER_BATCH_SIZE=25
TRUST_WORKER_MAX_ATTEMPTS=5
